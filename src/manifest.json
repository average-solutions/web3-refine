{
  "manifest_version": 3,
  "name": "web3-refine",
  "version": "0.1.0",
  "description": "Adds Tenderly, Dedaub and Phalcon transaction links to Blockscout explorers.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.blockscout.com/*"],
      "js": ["content/blockscout.js"],
      "css": ["content/blockscout.css"],
      "run_at": "document_idle"
    }
  ]
}
